;; meta-source on Overarch's banking example: the model as Overarch reads it
;; (examples/banking, unchanged) and atlas facts on the same ids
;; (examples/banking-atlas/registry), merged into one entity per id.
{:src []
 :registry ["examples/banking-atlas/registry"]
 :packs {atlas.meta-source/pack {}
         :overarch {:models ["examples/banking/model.edn" "examples/banking/views.edn"]}}
 :deps {io.github.semantic-namespace/atlas
        ;; atlas's branch feat/meta-source-types-from (:ontology/from), until it's merged
        {:git/url "https://github.com/semantic-namespace/atlas"
         :git/sha "302439121a20dd88620297f382f9a86879968633" :deps/root "core"}}}
